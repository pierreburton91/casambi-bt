// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python 3",
  "build": {
    // https://containers.dev/guide/dockerfile
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteEnv": {
    "MISTRAL_API_KEY": "${localEnv:MISTRAL_API_KEY}",
    "ESP_HOME_HOSTNAME": "${localEnv:ESP_HOME_HOSTNAME}"
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-python.isort",
        "ms-python.black-formatter"
      ],
      "settings": {
        "python.linting.enabled": true,
        "python.linting.ruffEnabled": true,
        "python.formatting.provider": "black",
        "python.sortImports.args": ["--profile", "black"],
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.env,target=/casambi-bt/.env,type=bind"
  ],

  // This installs dependencies and makes the local package importable in the venv.
    // Then run pipenv shell to activate the venv and start working.
  "postCreateCommand": "bash .devcontainer/setup.sh"

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
